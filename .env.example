DATABASE_URL=./data/job-radar.db
NEXT_PUBLIC_APP_URL=http://localhost:3000
HH_USER_AGENT=JobRadar/0.2 (your-email@example.com)

# Optional source credentials. Keep these server-side in .env.local; never put them in NEXT_PUBLIC_*.
# HH RSS, Getmatch, LinkedIn guest, Remote OK, Remotive and Arbeitnow work without keys.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
SUPERJOB_APP_ID=
JOOBLE_API_KEY=
JOOBLE_DOMAIN=jooble.org
JOOBLE_LOCATION=Remote
TELEGRAM_JOB_CHANNELS=
CAREER_BOARD_URLS=
CAREER_PAGE_URLS=
# Optional SMTP. Email is sent only after manual approval inside a vacancy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional future AI provider. The current scoring and Offer Sprint do not require an LLM.
AI_API_KEY=
AI_MODEL=gpt-5-mini
# Optional explicit AES-256 key for UI-entered source credentials (base64 or any passphrase hashed server-side).
# If omitted, a random local key is generated at data/.credentials.key.
SOURCE_CREDENTIALS_KEY=
